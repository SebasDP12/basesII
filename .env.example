# Puerto del servidor
PORT=3000
NODE_ENV=development

# 1. Hospital General - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hospital_general
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword

# 2. Clínica Odontológica - MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=clinica_odontologica
MYSQL_USER=admin
MYSQL_PASSWORD=adminpassword

# 3. Laboratorio Clínico - MongoDB
MONGO_URI=mongodb://localhost:27017/laboratorio_clinico

# 4. Centro Médico Pediátrico - Firebase Firestore
FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_PROJECT_ID=pediatria-project
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
