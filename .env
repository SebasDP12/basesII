# Puerto del servidor
PORT=3000
NODE_ENV=development

# 1. Hospital General - PostgreSQL (Expuesto en Docker en puerto 5433)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=hospital_general
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword

# 2. Clinica Odontologica - MySQL (Expuesto en Docker en puerto 3307)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DB=clinica_odontologica
MYSQL_USER=admin
MYSQL_PASSWORD=adminpassword

# 3. Laboratorio Clinico - MongoDB
MONGO_URI=mongodb://localhost:27017/laboratorio_clinico

# 4. Centro Medico Pediatrico - Firebase Firestore
FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_PROJECT_ID=pediatria-project
